    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "vite": "8.3.0",
    "vitest": "^4.1.7",
    "web-vitals": "^6.2.2",
    "wrangler": "^4.137.0"
  }
