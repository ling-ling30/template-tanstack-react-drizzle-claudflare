# ==============================================================================
# Gositus main app — environment (.env)
# ==============================================================================
# Node server (migrated off Cloudflare Workers). Copy to .env and fill in.
# DO NOT commit your real .env.

# --- Authentication (Better Auth) ---
BETTER_AUTH_URL="http://localhost:3000"
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-this-with-a-very-long-secure-random-string"
# Comma-separated superadmin emails (access /dashboard platform routes).
PLATFORM_ADMIN_EMAILS="owner@example.com"

# --- Database (MySQL, replaces D1) ---
DATABASE_URL="mysql://root:root@localhost:3306/gositus"

# --- Local object storage (replaces R2) ---
STORAGE_DIR="./.storage"

# --- Email (Mailgun SMTP via Nodemailer) ---
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Gositus <no-reply@gositus.ai>"

# --- AI service (backend-only, private) ---
AI_SERVICE_URL="https://staging.gositus.ai/api/v1"
# Service trust: prefer signed JWT (shared HMAC secret with the AI service).
AI_SERVICE_JWT_SECRET=""
# Fallback: static shared service key.
AI_SERVICE_KEY=""
