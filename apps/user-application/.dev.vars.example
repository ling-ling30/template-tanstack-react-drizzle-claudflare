# ==============================================================================
# Cloudflare Workers Local Development Variables (.dev.vars)
# ==============================================================================
# In Cloudflare Workers, local environment secrets are stored in a `.dev.vars`
# file instead of `.env`. Copy this file to `.dev.vars` and fill in the values.
# DO NOT commit your actual `.dev.vars` file to source control.

# ------------------------------------------------------------------------------
# Authentication (Better Auth)
# ------------------------------------------------------------------------------
# The base URL where your application is running. 
# Local development: http://localhost:3000
# Production: https://your-production-domain.com
BETTER_AUTH_URL="http://localhost:3000"

# A secure random string used to hash tokens and sign cookies.
# You can generate one via: `openssl rand -base64 32` or `npx auth secret`
BETTER_AUTH_SECRET="replace-this-with-a-very-long-secure-random-string"

# ------------------------------------------------------------------------------
# Application configuration
# ------------------------------------------------------------------------------
# A comma-separated list of emails that are granted super-admin permissions.
# These users can access the /platform routes and manage organizations.
PLATFORM_ADMIN_EMAILS="owner@example.com"
